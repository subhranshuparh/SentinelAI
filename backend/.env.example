# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# The extension NEVER sees these values; all keyed calls happen server-side.

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
# Used only for Tier-2 context-dependent PII detection and explanation text.
GEMINI_API_KEY=your-gemini-api-key-here
# Verified working on this project. NOTE: gemini-2.0-flash returns HTTP 429
# (zero free-tier quota) on AI Studio express keys — use 2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=4.0


# --- Google Safe Browsing v4 ---
# Must be a plain API key (Cloud console > Credentials > Create API key), NOT a
# service account: Safe Browsing v4 rejects OAuth bearer tokens with HTTP 400.
# Enable "Safe Browsing API" on the project. Free, no billing required.
SAFE_BROWSING_API_KEY=your-safe-browsing-api-key-here

# --- App ---
DATABASE_URL=sqlite:///./sentinel.db
# Comma-separated. Extension origin is added at runtime once the ID is known.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120

# --- Feature flags ---
# false = regex tier only (works with no Gemini key, and is the offline demo mode)
ENABLE_GEMINI_TIER=true
# false = single-user device-header mode. true = enforce JWT (not used in MVP demo).
ENABLE_JWT_AUTH=false
