{
  // Point VS Code at the project venv so Pylance resolves `app.*` imports and the
  // test explorer uses the same interpreter the terminal does. Without this the
  // editor red-underlines every import while the code runs fine, which is the
  // single most common "is my setup broken?" false alarm on this repo.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Tests live in backend/tests and import `app.*`, so pytest must run with
  // backend/ as its working directory.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["tests"],

  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },

  // node_modules and the venv make search results useless if indexed.
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true
  },

  "[python]": { "editor.rulers": [100] },
  "[typescript]": { "editor.rulers": [100] },
  "[typescriptreact]": { "editor.rulers": [100] }
}
